[Unit]
Description=Alberich web (FastAPI on loopback)
After=network.target

[Service]
User=finapp
Group=finapp
EnvironmentFile=/etc/finapp/finapp.env
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/finapp/app
ExecStart=/opt/finapp/venv/bin/uvicorn finapp.main:get_app --factory --host 127.0.0.1 --port 8100 --no-server-header --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/finapp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=400M

[Install]
WantedBy=multi-user.target
